{
  "name": "rv",
  "version": "1.0.0",
  "description": "Terminal tool for reviewing large PRs as agent-planned layers",
  "type": "module",
  "bin": { "rv": "src/index.ts" },
  "scripts": {
    "start": "bun run src/index.ts",
